{
  "name": "saas-platform",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.9.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "@nestjs/common": "11.1.18",
    "@nestjs/core": "11.1.18",
    "file-type": "21.3.4",
    "lodash": "4.17.24"
  },
  "scripts": {
    "dev": "concurrently \"npm run dev -w @saas/api\" \"npm run dev -w @saas/web\"",
    "dev:api": "npm run dev -w @saas/api",
    "dev:web": "npm run dev -w @saas/web",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "db:up": "docker compose -f docker-compose.dev.yml up -d",
    "db:down": "docker compose -f docker-compose.dev.yml down",
    "docker:prod:build": "docker compose --env-file .env.production build",
    "docker:prod:up": "docker compose --env-file .env.production up -d",
    "docker:prod:logs": "docker compose --env-file .env.production logs -f nginx backend frontend",
    "prisma:generate": "npm run prisma:generate -w @saas/api",
    "prisma:migrate": "npm run prisma:migrate -w @saas/api",
    "backup:repo": "powershell -ExecutionPolicy Bypass -File ./scripts/Create-RepoBackup.ps1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "concurrently": "^9.1.2"
  }
}
