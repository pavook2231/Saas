NODE_ENV=production

DOMAIN_NAME=app.example.com
LETSENCRYPT_EMAIL=infra@example.com

POSTGRES_DB=saas
POSTGRES_USER=saas
POSTGRES_PASSWORD=replace-with-strong-postgres-password
DATABASE_URL=postgresql://saas:replace-with-strong-postgres-password@postgres:5432/saas?schema=public
REDIS_URL=redis://redis:6379

API_PORT=3001
WEB_PORT=3000
CORS_ORIGIN=https://app.example.com
NEXT_PUBLIC_API_URL=https://app.example.com/api

JWT_ACCESS_SECRET=replace-with-64-plus-random-characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-another-64-plus-random-characters
JWT_REFRESH_EXPIRES_IN=30d
DATA_ENCRYPTION_KEY=replace-with-32-byte-base64-or-64-char-hex-key

REQUIRE_HTTPS=true
TRUST_PROXY=true
REQUEST_BODY_LIMIT=1mb
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=app.example.com
ENFORCE_VERIFIED_OAUTH_EMAIL=true

RATE_LIMIT_API_LIMIT=300
RATE_LIMIT_API_WINDOW_MS=60000
RATE_LIMIT_AUTH_LIMIT=10
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_REFRESH_LIMIT=30
RATE_LIMIT_REFRESH_WINDOW_MS=600000
RATE_LIMIT_OAUTH_LIMIT=20
RATE_LIMIT_OAUTH_WINDOW_MS=600000

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://app.example.com/api/auth/google/callback

VK_CLIENT_ID=
VK_CLIENT_SECRET=
VK_CALLBACK_URL=https://app.example.com/api/auth/vk/callback

YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
YANDEX_CALLBACK_URL=https://app.example.com/api/auth/yandex/callback

FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

REMINDER_OFFSETS_MINUTES=1440,60
