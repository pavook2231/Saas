generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrganizationRole {
  ADMIN
  DIRECTOR
  ASSISTANT
  MEMBER
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
  LEFT
  REJECTED
}

enum OrganizationInviteStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum OAuthProvider {
  GOOGLE
  VK
  YANDEX
}

enum OAuthAccountStatus {
  ACTIVE
  REVOKED
}

enum OauthStateAction {
  LOGIN
  LINK
}

enum ParticipantInviteStatus {
  NOT_SENT
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum EventType {
  PERFORMANCE
  REHEARSAL
  EVENT
  CUSTOM
}

enum EventStatus {
  DRAFT
  PLANNED
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum EventAttendanceStatus {
  INVITED
  ACCEPTED
  DECLINED
  ATTENDED
  ABSENT
}

enum AvailabilityStatus {
  AVAILABLE
  BUSY
  TENTATIVE
  UNAVAILABLE
}

enum AvailabilitySource {
  MANUAL
  EVENT
  IMPORTED
}

enum PointsLedgerType {
  AUTO_EVENT
  MANUAL_ADJUSTMENT
  CORRECTION
  BONUS
  PENALTY
}

enum PointsComputationStatus {
  PENDING
  CALCULATED
  LOCKED
  VOID
}

enum ManualPointsAuditAction {
  CREATED
  UPDATED
  DELETED
}

enum NotificationType {
  EVENT_ASSIGNED
  EVENT_UPDATED
  EVENT_REMINDER
  SYSTEM
}

enum NotificationChannel {
  WEB
  PUSH
}

enum NotificationDeliveryStatus {
  PENDING
  SENT
  FAILED
  READ
}

enum ChatScope {
  ORGANIZATION
  EVENT
}

enum PushProvider {
  FCM
}

enum AuditTargetType {
  ORGANIZATION
  MEMBERSHIP
  PARTICIPANT
  EVENT
  TEMPLATE
  POINTS
  MANUAL_POINTS
  NOTIFICATION
  CHAT
  FINANCE
  AUTH
  SETTINGS
}

enum AuditSeverity {
  INFO
  WARNING
  CRITICAL
}

enum PayrollPeriodStatus {
  OPEN
  CALCULATED
  APPROVED
  PAID
  CANCELLED
}

enum PayoutStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  CANCELLED
}

enum CurrencyCode {
  RUB
  USD
  EUR
  KZT
  BYN
  UZS
}

model User {
  id              String    @id @default(uuid()) @db.Uuid
  email           String    @unique
  passwordHash    String?
  isEmailVerified Boolean   @default(false)
  firstName       String?
  lastName        String?
  avatarUrl       String?
  phone           String?
  isActive        Boolean   @default(true)
  lastLoginAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  oauthAccounts               OauthAccount[]
  refreshTokens               RefreshToken[]
  organizationsCreated        Organization[]           @relation("OrganizationCreator")
  memberships                 Membership[]             @relation("MembershipUser")
  membershipsInvited          Membership[]             @relation("MembershipInviter")
  organizationInvitesSent     OrganizationInvite[]     @relation("OrganizationInviteSender")
  organizationInvitesAccepted OrganizationInvite[]     @relation("OrganizationInviteAcceptor")
  participants                Participant[]            @relation("ParticipantUser")
  participantsCreated         Participant[]            @relation("ParticipantCreator")
  participantInvitesSent      ParticipantInvite[]      @relation("ParticipantInviteSender")
  templatesCreated            Template[]               @relation("TemplateCreator")
  eventsCreated               Event[]                  @relation("EventCreator")
  eventsUpdated               Event[]                  @relation("EventUpdater")
  availabilityCreated         ParticipantAvailability[] @relation("AvailabilityCreator")
  pointsConfigsUpdated        PointsConfig[]           @relation("PointsConfigUpdater")
  pointRatesCreated           PointRateHistory[]       @relation("PointRateCreator")
  autoPointRuns               AutoPointsComputation[]  @relation("AutoPointsRunBy")
  pointsEntriesCreated        PointsLedgerEntry[]      @relation("PointsEntryCreator")
  manualPointsAdjustments     ManualPointsAdjustment[] @relation("ManualAdjustmentPerformer")
  manualPointsAudits          ManualPointsAudit[]      @relation("ManualAuditPerformer")
  auditLogs                   AuditLog[]               @relation("AuditActor")
  notificationsAuthored       Notification[]           @relation("NotificationActor")
  notificationRecipients      NotificationRecipient[]  @relation("NotificationRecipientUser")
  pushDeviceTokens            PushDeviceToken[]        @relation("UserPushDeviceTokens")
  chatMessagesSent            ChatMessage[]            @relation("ChatMessageSender")
  payrollGenerated            PayrollPeriod[]          @relation("PayrollGenerator")
  payrollApproved             PayrollPeriod[]          @relation("PayrollApprover")
  payoutsCreated              FinancePayout[]          @relation("PayoutCreator")
  payoutsProcessed            FinancePayout[]          @relation("PayoutProcessor")
  oauthStatesLinked           OauthState[]             @relation("OauthStateLinkUser")

  @@index([deletedAt])
}

model OauthAccount {
  id             String             @id @default(uuid()) @db.Uuid
  userId         String             @db.Uuid
  provider       OAuthProvider
  providerUserId String
  email          String?
  accessToken    String?
  refreshToken   String?
  idToken        String?
  tokenType      String?
  scopes         String?
  expiresAt      DateTime?
  status         OAuthAccountStatus @default(ACTIVE)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@unique([userId, provider])
  @@index([userId])
  @@index([provider, email])
}

model OauthState {
  id         String           @id @default(uuid()) @db.Uuid
  nonce      String           @unique
  provider   OAuthProvider
  action     OauthStateAction
  linkUserId String?          @db.Uuid
  clientState String?
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime         @default(now())

  linkUser User? @relation("OauthStateLinkUser", fields: [linkUserId], references: [id], onDelete: SetNull)

  @@index([provider, action, expiresAt, consumedAt])
  @@index([linkUserId, createdAt])
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  sessionId String?   @unique
  userAgent String?
  ipAddress String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([userId, revokedAt])
}

model Organization {
  id              String    @id @default(uuid()) @db.Uuid
  name            String
  slug            String    @unique
  legalName       String?
  description     String?
  timezone        String    @default("UTC")
  settings        Json?
  createdByUserId String?   @db.Uuid
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  createdBy               User?                    @relation("OrganizationCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  memberships             Membership[]
  invites                 OrganizationInvite[]
  participants            Participant[]
  participantInvites      ParticipantInvite[]
  templates               Template[]
  events                  Event[]
  availabilities          ParticipantAvailability[]
  pointsConfig            PointsConfig?
  pointRates              PointRateHistory[]
  autoPointRuns           AutoPointsComputation[]
  pointsLedger            PointsLedgerEntry[]
  manualPointsAdjustments ManualPointsAdjustment[]
  manualPointsAudits      ManualPointsAudit[]
  auditLogs               AuditLog[]
  notifications           Notification[]
  chatMessages            ChatMessage[]
  payrollPeriods          PayrollPeriod[]
  payrollLines            PayrollLine[]
  payouts                 FinancePayout[]

  @@index([createdByUserId])
  @@index([deletedAt])
}

model Membership {
  id              String           @id @default(uuid()) @db.Uuid
  organizationId  String           @db.Uuid
  userId          String           @db.Uuid
  role            OrganizationRole @default(MEMBER)
  status          MembershipStatus @default(INVITED)
  invitedByUserId String?          @db.Uuid
  invitedAt       DateTime         @default(now())
  acceptedAt      DateTime?
  leftAt          DateTime?
  suspendedAt     DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation("MembershipUser", fields: [userId], references: [id], onDelete: Cascade)
  invitedBy    User?        @relation("MembershipInviter", fields: [invitedByUserId], references: [id], onDelete: SetNull)

  @@unique([organizationId, userId])
  @@index([userId, status])
  @@index([organizationId, role, status])
}

model OrganizationInvite {
  id               String                   @id @default(uuid()) @db.Uuid
  organizationId   String                   @db.Uuid
  email            String
  role             OrganizationRole         @default(MEMBER)
  status           OrganizationInviteStatus @default(PENDING)
  tokenHash        String                   @unique
  invitedByUserId  String?                  @db.Uuid
  acceptedByUserId String?                  @db.Uuid
  expiresAt        DateTime
  acceptedAt       DateTime?
  revokedAt        DateTime?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy    User?        @relation("OrganizationInviteSender", fields: [invitedByUserId], references: [id], onDelete: SetNull)
  acceptedBy   User?        @relation("OrganizationInviteAcceptor", fields: [acceptedByUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, status, expiresAt])
  @@index([organizationId, email])
}

model Participant {
  id               String                  @id @default(uuid()) @db.Uuid
  organizationId   String                  @db.Uuid
  userId           String?                 @db.Uuid
  firstName        String
  lastName         String
  middleName       String?
  displayName      String?
  email            String?
  phone            String?
  notes            String?
  invitationStatus ParticipantInviteStatus @default(NOT_SENT)
  invitedAt        DateTime?
  linkedAt         DateTime?
  createdByUserId  String?                 @db.Uuid
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  deletedAt        DateTime?

  organization            Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user                    User?                    @relation("ParticipantUser", fields: [userId], references: [id], onDelete: SetNull)
  createdBy               User?                    @relation("ParticipantCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  invites                 ParticipantInvite[]
  templateAssignments     TemplateRoleAssignment[]
  eventAssignments        EventParticipant[]
  availabilities          ParticipantAvailability[]
  pointsLedger            PointsLedgerEntry[]
  manualPointsAdjustments ManualPointsAdjustment[]
  payrollLines            PayrollLine[]
  payouts                 FinancePayout[]

  @@unique([organizationId, userId])
  @@index([organizationId, lastName, firstName])
  @@index([organizationId, email])
  @@index([organizationId, deletedAt])
}

model ParticipantInvite {
  id              String                  @id @default(uuid()) @db.Uuid
  organizationId  String                  @db.Uuid
  participantId   String                  @db.Uuid
  invitedByUserId String?                 @db.Uuid
  email           String?
  phone           String?
  status          ParticipantInviteStatus @default(PENDING)
  tokenHash       String                  @unique
  expiresAt       DateTime
  acceptedAt      DateTime?
  revokedAt       DateTime?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  participant  Participant  @relation(fields: [participantId], references: [id], onDelete: Cascade)
  invitedBy    User?        @relation("ParticipantInviteSender", fields: [invitedByUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, status, expiresAt])
  @@index([participantId, status])
  @@index([email])
}

model Template {
  id              String    @id @default(uuid()) @db.Uuid
  organizationId  String    @db.Uuid
  name            String
  type            EventType @default(CUSTOM)
  description     String?
  durationMinutes Int
  isActive        Boolean   @default(true)
  createdByUserId String?   @db.Uuid
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation("TemplateCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  roles        TemplateRole[]
  events       Event[]

  @@index([organizationId, isActive])
  @@index([organizationId, deletedAt])
}

model TemplateRole {
  id            String   @id @default(uuid()) @db.Uuid
  templateId    String   @db.Uuid
  name          String
  requiredCount Int      @default(1)
  sortOrder     Int      @default(0)
  description   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  template          Template                 @relation(fields: [templateId], references: [id], onDelete: Cascade)
  assignments       TemplateRoleAssignment[]
  eventParticipants EventParticipant[]

  @@unique([templateId, name])
  @@index([templateId, sortOrder])
}

model TemplateRoleAssignment {
  id             String   @id @default(uuid()) @db.Uuid
  templateRoleId String   @db.Uuid
  participantId  String   @db.Uuid
  createdAt      DateTime @default(now())

  templateRole TemplateRole @relation(fields: [templateRoleId], references: [id], onDelete: Cascade)
  participant  Participant  @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@unique([templateRoleId, participantId])
  @@index([participantId])
}

model Event {
  id              String      @id @default(uuid()) @db.Uuid
  organizationId  String      @db.Uuid
  templateId      String?     @db.Uuid
  title           String
  description     String?
  type            EventType   @default(EVENT)
  status          EventStatus @default(PLANNED)
  startsAt        DateTime
  endsAt          DateTime
  durationMinutes Int
  timezone        String      @default("UTC")
  location        String?
  isAllDay        Boolean     @default(false)
  createdByUserId String?     @db.Uuid
  updatedByUserId String?     @db.Uuid
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  deletedAt       DateTime?

  organization  Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  template      Template?               @relation(fields: [templateId], references: [id], onDelete: SetNull)
  createdBy     User?                   @relation("EventCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  updatedBy     User?                   @relation("EventUpdater", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  participants  EventParticipant[]
  autoPointRuns AutoPointsComputation[]
  pointsLedger  PointsLedgerEntry[]
  notifications Notification[]
  reminderDispatches EventReminderDispatch[]
  chatMessages ChatMessage[]

  @@index([organizationId, startsAt])
  @@index([organizationId, status, startsAt])
  @@index([organizationId, deletedAt])
  @@index([templateId])
}

model EventParticipant {
  id               String                @id @default(uuid()) @db.Uuid
  eventId          String                @db.Uuid
  participantId    String                @db.Uuid
  templateRoleId   String?               @db.Uuid
  roleName         String?
  attendanceStatus EventAttendanceStatus @default(INVITED)
  isRequired       Boolean               @default(true)
  checkInAt        DateTime?
  checkOutAt       DateTime?
  notes            String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  event        Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  participant  Participant   @relation(fields: [participantId], references: [id], onDelete: Cascade)
  templateRole TemplateRole? @relation(fields: [templateRoleId], references: [id], onDelete: SetNull)
  pointsEntries PointsLedgerEntry[]

  @@unique([eventId, participantId])
  @@index([participantId, attendanceStatus])
  @@index([eventId, attendanceStatus])
}

model ParticipantAvailability {
  id              String             @id @default(uuid()) @db.Uuid
  organizationId  String             @db.Uuid
  participantId   String             @db.Uuid
  startsAt        DateTime
  endsAt          DateTime
  status          AvailabilityStatus @default(BUSY)
  source          AvailabilitySource @default(MANUAL)
  reason          String?
  createdByUserId String?            @db.Uuid
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  participant  Participant  @relation(fields: [participantId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation("AvailabilityCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, startsAt, endsAt])
  @@index([participantId, startsAt, endsAt])
}

model PointsConfig {
  id                      String       @id @default(uuid()) @db.Uuid
  organizationId          String       @unique @db.Uuid
  enabled                 Boolean      @default(false)
  periodStartDay          Int          @default(25)
  performanceLongMinutes  Int          @default(60)
  performanceLongPoints   Decimal      @default(3) @db.Decimal(12, 2)
  performanceShortPoints  Decimal      @default(2) @db.Decimal(12, 2)
  rehearsalMinutesPerPoint Int         @default(180)
  autoLockDays            Int          @default(7)
  pointValue              Decimal?     @db.Decimal(12, 2)
  currency                CurrencyCode @default(RUB)
  updatedByUserId         String?      @db.Uuid
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  updatedBy    User?        @relation("PointsConfigUpdater", fields: [updatedByUserId], references: [id], onDelete: SetNull)
}

model PointRateHistory {
  id              String       @id @default(uuid()) @db.Uuid
  organizationId  String       @db.Uuid
  effectiveFrom   DateTime
  pointValue      Decimal      @db.Decimal(12, 2)
  currency        CurrencyCode @default(RUB)
  createdByUserId String?      @db.Uuid
  createdAt       DateTime     @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation("PointRateCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@unique([organizationId, effectiveFrom])
  @@index([organizationId, effectiveFrom])
}

model AutoPointsComputation {
  id                   String                  @id @default(uuid()) @db.Uuid
  organizationId       String                  @db.Uuid
  eventId              String                  @db.Uuid
  runByUserId          String?                 @db.Uuid
  ruleVersion          Int                     @default(1)
  status               PointsComputationStatus @default(CALCULATED)
  startedAt            DateTime                @default(now())
  finishedAt           DateTime?
  generatedEntriesCount Int                    @default(0)
  generatedPoints      Decimal                 @default(0) @db.Decimal(12, 2)
  metadata             Json?

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  event        Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  runBy        User?              @relation("AutoPointsRunBy", fields: [runByUserId], references: [id], onDelete: SetNull)
  entries      PointsLedgerEntry[]

  @@index([organizationId, eventId, startedAt])
  @@index([status])
}

model PointsLedgerEntry {
  id                String                  @id @default(uuid()) @db.Uuid
  organizationId    String                  @db.Uuid
  participantId     String                  @db.Uuid
  eventId           String?                 @db.Uuid
  eventParticipantId String?                @db.Uuid
  autoComputationId String?                 @db.Uuid
  periodStart       DateTime
  periodEnd         DateTime
  type              PointsLedgerType
  computationStatus PointsComputationStatus @default(CALCULATED)
  points            Decimal                 @db.Decimal(12, 2)
  description       String?
  metadata          Json?
  createdByUserId   String?                 @db.Uuid
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  reversedAt        DateTime?

  organization    Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  participant     Participant            @relation(fields: [participantId], references: [id], onDelete: Cascade)
  event           Event?                 @relation(fields: [eventId], references: [id], onDelete: SetNull)
  eventParticipant EventParticipant?     @relation(fields: [eventParticipantId], references: [id], onDelete: SetNull)
  autoComputation AutoPointsComputation? @relation(fields: [autoComputationId], references: [id], onDelete: SetNull)
  createdBy       User?                  @relation("PointsEntryCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  manualAdjustment ManualPointsAdjustment?
  manualAudits    ManualPointsAudit[]
  payrollLinks    PayrollLinePointEntry[]

  @@index([organizationId, periodStart, periodEnd])
  @@index([participantId, periodStart])
  @@index([eventId, type])
  @@index([eventParticipantId])
  @@index([autoComputationId])
  @@index([organizationId, type, createdAt])
}

model ManualPointsAdjustment {
  id                String    @id @default(uuid()) @db.Uuid
  organizationId    String    @db.Uuid
  ledgerEntryId     String    @unique @db.Uuid
  participantId     String    @db.Uuid
  performedByUserId String    @db.Uuid
  reason            String
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ledgerEntry  PointsLedgerEntry @relation(fields: [ledgerEntryId], references: [id], onDelete: Cascade)
  participant  Participant       @relation(fields: [participantId], references: [id], onDelete: Cascade)
  performedBy  User              @relation("ManualAdjustmentPerformer", fields: [performedByUserId], references: [id], onDelete: Restrict)
  audits       ManualPointsAudit[]

  @@index([organizationId, participantId, createdAt])
  @@index([performedByUserId, createdAt])
}

model ManualPointsAudit {
  id                String                  @id @default(uuid()) @db.Uuid
  organizationId    String                  @db.Uuid
  manualAdjustmentId String                 @db.Uuid
  ledgerEntryId     String                  @db.Uuid
  action            ManualPointsAuditAction
  performedByUserId String                  @db.Uuid
  reason            String
  oldData           Json?
  newData           Json?
  createdAt         DateTime                @default(now())

  organization     Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  manualAdjustment ManualPointsAdjustment @relation(fields: [manualAdjustmentId], references: [id], onDelete: Cascade)
  ledgerEntry      PointsLedgerEntry      @relation(fields: [ledgerEntryId], references: [id], onDelete: Cascade)
  performedBy      User                   @relation("ManualAuditPerformer", fields: [performedByUserId], references: [id], onDelete: Restrict)

  @@index([organizationId, createdAt])
  @@index([manualAdjustmentId, createdAt])
  @@index([ledgerEntryId])
}

model AuditLog {
  id           String         @id @default(uuid()) @db.Uuid
  organizationId String?      @db.Uuid
  actorUserId  String?        @db.Uuid
  targetType   AuditTargetType
  targetId     String?
  action       String
  severity     AuditSeverity  @default(INFO)
  description  String?
  ipAddress    String?
  userAgent    String?
  requestId    String?
  payload      Json?
  createdAt    DateTime       @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  actor        User?         @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([targetType, targetId])
  @@index([requestId])
}

model Notification {
  id              String           @id @default(uuid()) @db.Uuid
  organizationId  String?          @db.Uuid
  eventId         String?          @db.Uuid
  actorUserId     String?          @db.Uuid
  type            NotificationType
  title           String
  body            String
  payload         Json?
  createdAt       DateTime         @default(now())

  organization Organization?           @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  event        Event?                  @relation(fields: [eventId], references: [id], onDelete: SetNull)
  actor        User?                   @relation("NotificationActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  recipients   NotificationRecipient[]

  @@index([organizationId, createdAt])
  @@index([eventId, createdAt])
  @@index([type, createdAt])
}

model NotificationRecipient {
  id             String                     @id @default(uuid()) @db.Uuid
  notificationId String                     @db.Uuid
  userId         String                     @db.Uuid
  channel        NotificationChannel
  status         NotificationDeliveryStatus @default(PENDING)
  errorMessage   String?
  deliveredAt    DateTime?
  readAt         DateTime?
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user         User         @relation("NotificationRecipientUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([notificationId, userId, channel])
  @@index([userId, channel, status, createdAt])
}

model PushDeviceToken {
  id         String       @id @default(uuid()) @db.Uuid
  userId     String       @db.Uuid
  provider   PushProvider @default(FCM)
  token      String
  tokenHash  String       @unique
  platform   String?
  deviceId   String?
  isActive   Boolean      @default(true)
  lastSeenAt DateTime?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  user User @relation("UserPushDeviceTokens", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isActive, updatedAt])
}

model SecurityRateLimit {
  key       String   @id
  hits      Int      @default(0)
  resetAt   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([resetAt])
}

model EventReminderDispatch {
  id           String   @id @default(uuid()) @db.Uuid
  eventId      String   @db.Uuid
  reminderKey  String
  reminderAt   DateTime
  status       NotificationDeliveryStatus @default(PENDING)
  errorMessage String?
  sentAt       DateTime?
  createdAt    DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, reminderKey])
  @@index([reminderAt, sentAt])
}

model ChatMessage {
  id              String    @id @default(uuid()) @db.Uuid
  organizationId  String    @db.Uuid
  eventId         String?   @db.Uuid
  senderUserId    String    @db.Uuid
  scope           ChatScope
  body            String    @db.Text
  metadata        Json?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  editedAt        DateTime?
  deletedAt       DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  event        Event?       @relation(fields: [eventId], references: [id], onDelete: SetNull)
  sender       User         @relation("ChatMessageSender", fields: [senderUserId], references: [id], onDelete: Restrict)

  @@index([organizationId, scope, createdAt])
  @@index([eventId, createdAt])
  @@index([senderUserId, createdAt])
  @@index([organizationId, deletedAt, createdAt])
}

model PayrollPeriod {
  id               String              @id @default(uuid()) @db.Uuid
  organizationId   String              @db.Uuid
  startsAt         DateTime
  endsAt           DateTime
  status           PayrollPeriodStatus @default(OPEN)
  pointValue       Decimal             @db.Decimal(12, 2)
  currency         CurrencyCode        @default(RUB)
  totalAutoPoints  Decimal             @default(0) @db.Decimal(12, 2)
  totalManualPoints Decimal            @default(0) @db.Decimal(12, 2)
  totalPoints      Decimal             @default(0) @db.Decimal(12, 2)
  totalAmount      Decimal             @default(0) @db.Decimal(14, 2)
  generatedByUserId String?            @db.Uuid
  approvedByUserId String?             @db.Uuid
  approvedAt       DateTime?
  paidAt           DateTime?
  notes            String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  generatedBy  User?         @relation("PayrollGenerator", fields: [generatedByUserId], references: [id], onDelete: SetNull)
  approvedBy   User?         @relation("PayrollApprover", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  lines        PayrollLine[]
  payouts      FinancePayout[]

  @@unique([organizationId, startsAt, endsAt])
  @@index([organizationId, status, startsAt])
  @@index([generatedByUserId])
}

model PayrollLine {
  id               String       @id @default(uuid()) @db.Uuid
  organizationId   String       @db.Uuid
  payrollPeriodId  String       @db.Uuid
  participantId    String       @db.Uuid
  autoPoints       Decimal      @default(0) @db.Decimal(12, 2)
  manualPoints     Decimal      @default(0) @db.Decimal(12, 2)
  correctionPoints Decimal      @default(0) @db.Decimal(12, 2)
  totalPoints      Decimal      @db.Decimal(12, 2)
  pointValue       Decimal      @db.Decimal(12, 2)
  amount           Decimal      @db.Decimal(14, 2)
  currency         CurrencyCode @default(RUB)
  metadata         Json?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  payrollPeriod PayrollPeriod        @relation(fields: [payrollPeriodId], references: [id], onDelete: Cascade)
  participant   Participant           @relation(fields: [participantId], references: [id], onDelete: Restrict)
  pointEntries  PayrollLinePointEntry[]

  @@unique([payrollPeriodId, participantId])
  @@index([organizationId, participantId])
  @@index([payrollPeriodId])
}

model PayrollLinePointEntry {
  id                String    @id @default(uuid()) @db.Uuid
  payrollLineId     String    @db.Uuid
  pointsLedgerEntryId String  @db.Uuid
  createdAt         DateTime  @default(now())

  payrollLine      PayrollLine       @relation(fields: [payrollLineId], references: [id], onDelete: Cascade)
  pointsLedgerEntry PointsLedgerEntry @relation(fields: [pointsLedgerEntryId], references: [id], onDelete: Cascade)

  @@unique([payrollLineId, pointsLedgerEntryId])
  @@index([pointsLedgerEntryId])
}

model FinancePayout {
  id                   String       @id @default(uuid()) @db.Uuid
  organizationId       String       @db.Uuid
  payrollPeriodId      String?      @db.Uuid
  participantId        String       @db.Uuid
  amount               Decimal      @db.Decimal(14, 2)
  currency             CurrencyCode @default(RUB)
  status               PayoutStatus @default(PENDING)
  paymentMethod        String?
  reference            String?
  externalTransactionId String?     @unique
  createdByUserId      String?      @db.Uuid
  processedByUserId    String?      @db.Uuid
  processedAt          DateTime?
  failedAt             DateTime?
  failureReason        String?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  payrollPeriod PayrollPeriod? @relation(fields: [payrollPeriodId], references: [id], onDelete: SetNull)
  participant Participant @relation(fields: [participantId], references: [id], onDelete: Restrict)
  createdBy User? @relation("PayoutCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  processedBy User? @relation("PayoutProcessor", fields: [processedByUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, status, createdAt])
  @@index([participantId, status, createdAt])
  @@index([payrollPeriodId])
}
