SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Внутренний сервис театра <no-reply@example.com>"

REMINDER_OFFSETS_MINUTES=1440,60
