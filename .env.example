NODE_ENV=development

DATABASE_URL=postgresql://saas:saas@localhost:5432/saas?schema=public
REDIS_URL=redis://localhost:6379

API_PORT=3001
WEB_PORT=3000
CORS_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001/api

JWT_ACCESS_SECRET=replace-with-strong-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-strong-refresh-secret
JWT_REFRESH_EXPIRES_IN=30d
JWT_OAUTH_STATE_SECRET=replace-with-separate-oauth-state-secret
DATA_ENCRYPTION_KEY=development-only-encryption-key-change-me

REQUIRE_HTTPS=false
TRUST_PROXY=false
REQUEST_BODY_LIMIT=1mb
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=
ENFORCE_VERIFIED_OAUTH_EMAIL=true
RATE_LIMIT_API_LIMIT=300
RATE_LIMIT_API_WINDOW_MS=60000
RATE_LIMIT_AUTH_LIMIT=10
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_REFRESH_LIMIT=30
RATE_LIMIT_REFRESH_WINDOW_MS=600000
RATE_LIMIT_OAUTH_LIMIT=20
RATE_LIMIT_OAUTH_WINDOW_MS=600000

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback

VK_CLIENT_ID=
VK_CLIENT_SECRET=
VK_CALLBACK_URL=http://localhost:3001/api/auth/vk/callback

YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
YANDEX_CALLBACK_URL=http://localhost:3001/api/auth/yandex/callback

FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
